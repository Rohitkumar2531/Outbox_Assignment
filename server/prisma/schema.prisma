generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
  cancelled
}

model User {
  id        String             @id @default(cuid())
  googleId  String?            @unique
  name      String
  email     String             @unique
  avatar    String?
  createdAt DateTime           @default(now())
  senders   Sender[]
  campaigns EmailCampaign[]
  emails    Email[]
  slack     SlackIntegration?
}

model Sender {
  id              String          @id @default(cuid())
  userId          String
  email           String
  smtpConfig      Json
  hourlyLimit     Int             @default(200)
  minDelaySeconds Int             @default(2)
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns       EmailCampaign[]
  emails          Email[]

  @@unique([userId, email])
  @@index([userId])
}

model EmailCampaign {
  id        String   @id @default(cuid())
  userId    String
  senderId  String
  subject   String
  body      String   @db.LongText
  startAt   DateTime
  status    String   @default("scheduled")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    Sender   @relation(fields: [senderId], references: [id])
  emails    Email[]

  @@index([userId, createdAt])
}

model Email {
  id             String      @id @default(cuid())
  campaignId     String
  userId         String
  senderId       String
  recipient      String
  subject        String
  body           String      @db.LongText
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(scheduled)
  idempotencyKey String      @unique
  errorMessage   String?     @db.Text
  providerMessageId String?
  previewUrl     String?
  indexedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         Sender        @relation(fields: [senderId], references: [id])
  outbox         Outbox?

  @@index([userId, status, scheduledAt])
  @@index([senderId, status, scheduledAt])
}

model Outbox {
  id           String    @id @default(cuid())
  emailId      String    @unique
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  attempts     Int       @default(0)
  email        Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, createdAt])
}

model SlackIntegration {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String   @db.Text
  teamId      String
  slackUserId String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
