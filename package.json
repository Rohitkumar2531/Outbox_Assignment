{
  "name": "reachinbox",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {"dev": "concurrently -n server,worker,client -c blue,magenta,green \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:client\"", "dev:server": "npm --workspace server run dev", "dev:worker": "npm --workspace server run worker:dev", "dev:client": "npm --workspace client run dev", "build": "npm run build --workspace server && npm run build --workspace client", "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client"},
  "devDependencies": {"concurrently": "^9.1.2", "typescript": "^5.7.3"}
}
